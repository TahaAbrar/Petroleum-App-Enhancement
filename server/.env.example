# FuelLedger API — copy to `.env` and fill real values
NODE_ENV=development
PORT=4000

# SQL Server (Docker) — API uses READ-ONLY SELECT for login only
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=X5PS
DB_USER=sa
DB_PASSWORD=your_sa_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Auth / security
JWT_SECRET=change_me_to_long_random_hex
JWT_EXPIRES_IN=8h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
