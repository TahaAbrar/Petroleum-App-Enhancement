# FuelLedger API — copy to `.env` and fill real values
NODE_ENV=development
PORT=4000

# SQL Server (Docker or remote / WireGuard client)
DB_SERVER=127.0.0.1
DB_PORT=1433
# Named instance (optional) — e.g. SQLEXPRESS. When set, port is resolved via SQL Browser (UDP 1434)
# DB_INSTANCE=SQLEXPRESS
DB_DATABASE=X5PS
DB_USER=sa
DB_PASSWORD=your_sa_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# DB_CONNECTION_TIMEOUT=20000
# DB_REQUEST_TIMEOUT=15000

# Auth / security
JWT_SECRET=change_me_to_long_random_hex
JWT_EXPIRES_IN=365d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Required header X-FuelLedger-Key on customer read APIs (same value as VITE_API_READ_KEY)
API_READ_KEY=change_me_to_long_random_hex

# Web Push (API watcher → browsers). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alicomz.com
